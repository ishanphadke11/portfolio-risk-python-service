# Flask environment (development/production/testing)
FLASK_ENV=development

# Service port
PYTHON_SERVICE_PORT=5001

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Path to Fama-French data file
FF_DATA_PATH=data/F-F_Research_Data_5_Factors_2x3_daily.csv

# Default lookback period for analysis (years)
DEFAULT_LOOKBACK_YEARS=3
